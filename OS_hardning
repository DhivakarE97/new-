### OS ORDNINGSCRIPT
#!/bin/bash
# OS Hardening Script for CentOS 9
# Run as root

echo "[+] Starting CentOS 9 Hardening..."

# 1. Update all packagesl
echo "[+] Updating system packages..."
dnf update -y
###############Below updating host file ####

echo "sed for hosts.allow" sed -i /etc/hosts.allow > sed -d > npci.org.in 

eco "updating apt file " sed -i /etc/apt/source.list > cron " 00:00 " > 

# 2. Disable root SSH login
echo "[+] Disabling root SSH login..."
sed -i 's/^#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
systemctl restart sshd

# 3. Enforce password policies
echo "[+] Enforcing password policies..."
authselect select sssd with-password-quality --force
# Set minimum password length
sed -i 's/^minlen.*/minlen = 12/' /etc/security/pwquality.conf
# Prevent old password reuse
echo "remember = 5" >> /etc/security/pwquality.conf

# 4. Set password aging
echo "[+] Setting password aging..."
chage --maxdays 90 root
chage --mindays 7 root

# 5. Enable firewall and allow only SSH, HTTP, HTTPS
echo "[+] Configuring firewall..."
systemctl enable --now firewalld
firewall-cmd --permanent --add-service=ssh
firewall-cmd --permanent --add-service=http
firewall-cmd --permanent --add-service=https
firewall-cmd 	

# 6. Disable unused services
echo "[+] Disabling unnecessary services..."
systemctl disable cups --now 2>/dev/null
systemctl disable avahi-daemon --now 2>/dev/null
systemctl disable rpcbind --now 2>/dev/null

# 7. Enable auditing
echo "[+] Enabling auditd..."
dnf install -y audit
systemctl enable --now auditd

# 8. Enable SELinux in enforcing mode
echo "[+] Enforcing SELinux..."
sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
setenforce 1

# 9. Protect shared memory
echo "[+] Protecting shared memory..."
echo "tmpfs /dev/shm tmpfs defaults,noexec,nosuid,nodev 0 0" >> /etc/fstab
mount -o remount /dev/shm

# 10. World writable files check
echo "[+] Searching world writable files..."
find / -xdev -type f -perm -0002 -exec ls -l {} \; > /root/world_writable_files.txt

# 11. Limit cron to root users only
echo "[+] Restricting cron usage..."
echo "root" > /etc/cron.allow
chmod 600 /etc/cron.allow

# 12. Log suspicious login attempts
echo "[+] Configuring faillock..."
authselect enable-feature with-faillock
authselect apply-changes

echo "[+] Hardening completed. Please reboot for all changes to take effect."
